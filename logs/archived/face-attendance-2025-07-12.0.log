            <input type="radio" class="btn-check" name="timeRange" id="month">
            <label class="btn btn-outline-primary" for="month">Tháng</label>

            <input type="radio" class="btn-check" name="timeRange" id="semester">
            <label class="btn btn-outline-primary" for="semester">Học kỳ</label>
          </div>
        </div>

        <div class="attendance-stats">
          <div class="attendance-card present">
            <div class="attendance-number" id="presentCount">0</div>
            <div class="text-muted">Có mặt</div>
            <div class="mt-2">
              <small class="text-success">
                <i class="fas fa-arrow-up"></i> <span id="presentTrend">0%</span>
              </small>
            </div>
          </div>
          <div class="attendance-card absent">
            <div class="attendance-number" id="absentCount">0</div>
            <div class="text-muted">Vắng mặt</div>
            <div class="mt-2">
              <small class="text-danger">
                <i class="fas fa-arrow-down"></i> <span id="absentTrend">0%</span>
              </small>
            </div>
          </div>
          <div class="attendance-card late">
            <div class="attendance-number" id="lateCount">0</div>
            <div class="text-muted">Đi muộn</div>
            <div class="mt-2">
              <small class="text-warning">
                <i class="fas fa-minus"></i> <span id="lateTrend">0%</span>
              </small>
            </div>
          </div>
          <div class="attendance-card">
            <div class="attendance-number" style="color: #667eea;" id="attendanceRate">0%</div>
            <div class="text-muted">Tỷ lệ điểm danh</div>
            <div class="mt-2">
              <small class="text-primary">
                <i class="fas fa-arrow-up"></i> <span id="rateTrend">0%</span>
              </small>
            </div>
          </div>
        </div>

        <!-- Chart Container -->
        <div class="chart-container">
          <canvas id="attendanceChart"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>
</div>

<!-- Manual Attendance Modal -->
<div class="modal fade" id="manualAttendanceModal" tabindex="-1" aria-labelledby="manualAttendanceModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="manualAttendanceModalLabel">
          <i class="fas fa-edit"></i> Điểm danh thủ công
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="row mb-3">
          <div class="col-md-6">
            <label for="attendanceSchedule" class="form-label">Chọn buổi học:</label>
            <select class="form-select" id="attendanceSchedule">
              <option value="">-- Chọn buổi học hôm nay --</option>
            </select>
          </div>
          <div class="col-md-6">
            <label for="attendanceDate" class="form-label">Ngày điểm danh:</label>
            <input type="date" class="form-control" id="attendanceDate" readonly>
          </div>
        </div>

        <div id="attendanceCounter" class="alert alert-info mb-3" style="display: none;"></div>

        <div class="table-responsive">
          <table class="table table-striped">
            <thead>
            <tr>
              <th>STT</th>
              <th>Mã SV</th>
              <th>Họ tên</th>
              <th>Trạng thái</th>
              <th>Giờ vào</th>
              <th>Giờ ra</th>
            </tr>
            </thead>
            <tbody id="attendanceTableBody">
            </tbody>
          </table>
        </div>

        <div class="mt-3">
          <button type="button" class="btn btn-success" onclick="markAllPresent()">
            <i class="fas fa-check"></i> Tất cả có mặt
          </button>
          <button type="button" class="btn btn-danger" onclick="markAllAbsent()">
            <i class="fas fa-times"></i> Tất cả vắng mặt
          </button>
          <button type="button" class="btn btn-secondary" onclick="clearAllAttendance()">
            <i class="fas fa-undo"></i> Xóa tất cả
          </button>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
        <button type="button" class="btn btn-primary" onclick="saveManualAttendance()">
          <i class="fas fa-save"></i> Lưu điểm danh
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
  // Global variables
  let currentClassId = /*[[${lopHocPhan?.maLhp}]]*/ '';
  let attendanceData = [];
  let todaySchedules = [];
  let existingAttendance = [];

  // Notification function
  function showNotification(message, type = 'info') {
    const toast = document.createElement('div');
    toast.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
    toast.style.top = '20px';
    toast.style.right = '20px';
    toast.style.zIndex = '9999';
    toast.innerHTML = `
      ${message}
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    `;
    document.body.appendChild(toast);

    setTimeout(() => {
      if (toast.parentNode) {
        toast.parentNode.removeChild(toast);
      }
    }, 5000);
  }

  // Debounce function for search
  function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  // Initialize page when DOM is loaded
  document.addEventListener('DOMContentLoaded', function() {
    if (currentClassId) {
      loadAttendanceStats();
      loadStudentAttendanceData();
      initializeSearch();
      initializeCharts();
    }

    // Add loading animations
    addLoadingAnimations();
  });

  // Load attendance statistics
  async function loadAttendanceStats() {
    try {
      const response = await fetch(`/api/diemdanh/stats/class/${currentClassId}`);
      if (response.ok) {
        const stats = await response.json();
        updateAttendanceStatsDisplay(stats);
      }
    } catch (error) {
      console.error('Error loading attendance stats:', error);
    }
  }

  // Update attendance stats display
  function updateAttendanceStatsDisplay(stats) {
    document.getElementById('presentCount').textContent = stats.presentCount || 0;
    document.getElementById('absentCount').textContent = stats.absentCount || 0;
    document.getElementById('lateCount').textContent = stats.lateCount || 0;
    document.getElementById('attendanceRate').textContent = (stats.attendanceRate || 0).toFixed(1) + '%';
    document.getElementById('overallAttendanceRate').textContent = (stats.attendanceRate || 0).toFixed(1) + '%';

    // Update trends (mockup for now)
    document.getElementById('presentTrend').textContent = '+5% so với tuần trước';
    document.getElementById('absentTrend').textContent = '-2% so với tuần trước';
    document.getElementById('lateTrend').textContent = 'Không đổi';
    document.getElementById('rateTrend').textContent = '+3% so với tuần trước';
  }

  // Load student attendance data - FIX FOR THE ORIGINAL ISSUE
  async function loadStudentAttendanceData() {
    try {
      const response = await fetch(`/api/diemdanh/stats/students/${currentClassId}`);
      if (response.ok) {
        const studentStats = await response.json();
        updateStudentCards(studentStats);
      }
    } catch (error) {
      console.error('Error loading student attendance:', error);
      // Show error message in student cards
      updateStudentCardsError();
    }
  }

  // Update student cards with attendance info - FIXED VERSION
  function updateStudentCards(studentStats) {
    const studentCards = document.querySelectorAll('.student-card');

    studentCards.forEach(card => {
      // Get student ID from the card - make sure selector is correct
      const studentIdElement = card.querySelector('.student-id');
      if (!studentIdElement) {
        console.warn('Student ID element not found in card');
        return;
      }

      const studentId = studentIdElement.textContent.trim();
      const stat = studentStats.find(s => s.maSv === studentId);

      // Find attendance info container
      const attendanceInfo = card.querySelector('.attendance-info');
      if (!attendanceInfo) {
        console.warn('Attendance info element not found in card for student:', studentId);
        return;
      }

      if (stat) {
        const attendanceRate = stat.attendanceRate || 0;

        attendanceInfo.innerHTML = `
          <small>
            <i class="fas fa-check-circle"></i>
            Tỷ lệ điểm danh: <span class="fw-bold">${attendanceRate.toFixed(1)}%</span>
          </small>
        `;

        // Add color coding based on attendance rate
        attendanceInfo.className = 'attendance-info';
        if (attendanceRate >= 90) {
          attendanceInfo.classList.add('text-success');
        } else if (attendanceRate >= 75) {
          attendanceInfo.classList.add('text-warning');
        } else {
          attendanceInfo.classList.add('text-danger');
        }
      } else {
        // No attendance data found for this student
        attendanceInfo.innerHTML = `
          <small class="text-muted">
            <i class="fas fa-question-circle"></i>
            Chưa có dữ liệu điểm danh
          </small>
        `;
        attendanceInfo.className = 'attendance-info text-muted';
      }
    });
  }

  // Update student cards when there's an error loading data
  function updateStudentCardsError() {
    const studentCards = document.querySelectorAll('.student-card');

    studentCards.forEach(card => {
      const attendanceInfo = card.querySelector('.attendance-info');
      if (attendanceInfo) {
        attendanceInfo.innerHTML = `
          <small class="text-muted">
            <i class="fas fa-exclamation-triangle"></i>
            Không thể tải dữ liệu
          </small>
        `;
        attendanceInfo.className = 'attendance-info text-muted';
      }
    });
  }

  // Search functionality
  function searchStudents() {
    const searchTerm = document.getElementById('searchStudent').value.toLowerCase();
    const studentCards = document.querySelectorAll('.student-card');

    studentCards.forEach(card => {
      const studentName = card.querySelector('.student-details h6').textContent.toLowerCase();
      const studentId = card.querySelector('.student-id').textContent.toLowerCase();
      const studentEmail = card.querySelector('.student-email').textContent.toLowerCase();

      if (studentName.includes(searchTerm) ||
              studentId.includes(searchTerm) ||
              studentEmail.includes(searchTerm)) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function initializeSearch() {
    const searchInput = document.getElementById('searchStudent');
    if (searchInput) {
      searchInput.addEventListener('input', debounce(searchStudents, 300));
    }
  }

  // Initialize charts
  function initializeCharts() {
    // Attendance Chart
    const ctx = document.getElementById('attendanceChart');
    if (ctx) {
      new Chart(ctx, {
        type: 'line',
        data: {
          labels: ['Tuần 1', 'Tuần 2', 'Tuần 3', 'Tuần 4', 'Tuần 5', 'Tuần 6'],
          datasets: [{
            label: 'Tỷ lệ điểm danh (%)',
            data: [85, 88, 92, 87, 90, 93],
            borderColor: '#667eea',
            backgroundColor: 'rgba(102, 126, 234, 0.1)',
            tension: 0.4,
            fill: true
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: false
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              max: 100,
              ticks: {
                callback: function(value) {
                  return value + '%';
                }
              }
            }
          }
        }
      });
    }
  }

  // Load today's schedules for the class
  async function loadTodaySchedules() {
    try {
      const today = new Date();
      const dayOfWeek = today.getDay(); // 0 = Sunday, 1 = Monday, etc.
      const vietnamDayOfWeek = dayOfWeek === 0 ? 7 : dayOfWeek; // Convert to Vietnam format (2 = Monday)

      const response = await fetch(`/api/lichhoc/by-lhp/${currentClassId}`);
      if (response.ok) {
        const allSchedules = await response.json();
        // Filter schedules for today
        todaySchedules = allSchedules.filter(schedule => schedule.thu === vietnamDayOfWeek);
      }
    } catch (error) {
      console.error('Error loading today schedules:', error);
    }
  }

  // Open manual attendance modal
  async function openManualAttendance() {
    // Load today's schedules first
    await loadTodaySchedules();

    if (todaySchedules.length === 0) {
      showNotification('Hôm nay không có lịch học nào cho lớp này!', 'warning');
      return;
    }

    // Set today's date (locked)
    const today = new Date().toISOString().split('T')[0];
    const dateInput = document.getElementById('attendanceDate');
    dateInput.value = today;
    dateInput.disabled = true; // Lock to today only

    // Populate schedule dropdown with today's schedules only
    const scheduleSelect = document.getElementById('attendanceSchedule');
    scheduleSelect.innerHTML = '<option value="">-- Chọn buổi học hôm nay --</option>';

    todaySchedules.forEach(schedule => {
      const option = document.createElement('option');
      option.value = schedule.maLich;
      option.textContent = `Tiết ${schedule.tietBatDau}-${schedule.tietBatDau + schedule.soTiet - 1} (${schedule.tenPhong})`;
      scheduleSelect.appendChild(option);
    });

    // Show modal
    const modal = new bootstrap.Modal(document.getElementById('manualAttendanceModal'));
    modal.show();

    // Add schedule selection event
    scheduleSelect.addEventListener('change', loadStudentListForAttendance);
  }

  // Load student list for manual attendance
  async function loadStudentListForAttendance() {
    const scheduleSelect = document.getElementById('attendanceSchedule');
    const selectedScheduleId = scheduleSelect.value;

    if (!selectedScheduleId) {
      document.getElementById('attendanceTableBody').innerHTML = '';
      return;
    }

    // Load existing attendance for this schedule today
    await loadExistingAttendance(selectedScheduleId);

    const tbody = document.getElementById('attendanceTableBody');
    const studentCards = document.querySelectorAll('.student-card');

    tbody.innerHTML = '';
    attendanceData = [];

    // Get current time for default
    const now = new Date();
    const currentTime = now.toTimeString().slice(0, 5);

    studentCards.forEach((card, index) => {
      const studentName = card.querySelector('.student-details h6').textContent;
      const studentId = card.querySelector('.student-id').textContent;

      // Check if student already has attendance
      const existingRecord = existingAttendance.find(record => record.maSv === studentId);
      const isAlreadyAttended = !!existingRecord;

      const row = document.createElement('tr');
      row.className = isAlreadyAttended ? 'table-success' : '';

      row.innerHTML = `
        <td>${index + 1}</td>
        <td>${studentId}</td>
        <td>${studentName}</td>
        <td>
          ${isAlreadyAttended ?
              `<span class="badge bg-success">Đã điểm danh</span>` :
              `<select class="form-select attendance-status" data-student="${studentId}">
              <option value="">-- Chọn trạng thái --</option>
              <option value="CO_MAT">Có mặt</option>
              <option value="VANG_MAT">Vắng mặt</option>
              <option value="DI_MUON">Đi muộn</option>
            </select>`
      }
        </td>
        <td>
          ${isAlreadyAttended ?
              `<span>${existingRecord.thoiGianVao || 'N/A'}</span>` :
              `<input type="time" class="form-control time-in" data-student="${studentId}">`
      }
        </td>
        <td>
          ${isAlreadyAttended ?
              `<span>${existingRecord.thoiGianRa || 'N/A'}</span>` :
              `<input type="time" class="form-control time-out" data-student="${studentId}">`
      }
        </td>
      `;

      tbody.appendChild(row);

      // Add to attendance data if not already attended
      if (!isAlreadyAttended) {
        attendanceData.push({
          maSv: studentId,
          tenSv: studentName,
          trangThai: null,
          thoiGianVao: null,
          thoiGianRa: null
        });
      }
    });

    // Add event listeners
    tbody.querySelectorAll('.attendance-status, .time-in, .time-out').forEach(input => {
      input.addEventListener('change', updateAttendanceData);
    });

    updateAttendanceCounter();
  }

  // Load existing attendance for the selected schedule
  async function loadExistingAttendance(scheduleId) {
    try {
      const today = new Date().toISOString().split('T')[0];
      const response = await fetch(`/api/diemdanh/by-malich/${scheduleId}?date=${today}`);
      if (response.ok) {
        existingAttendance = await response.json();
      } else {
        existingAttendance = [];
      }
    } catch (error) {
      console.error('Error loading existing attendance:', error);
      existingAttendance = [];
    }
  }

  // Update attendance counter
  function updateAttendanceCounter() {
    const counterElement = document.getElementById('attendanceCounter');
    const total = attendanceData.length;
    const attended = attendanceData.filter(s => s.trangThai).length;
    const unattended = total - attended;

    counterElement.style.display = total > 0 ? 'block' : 'none';
    counterElement.innerHTML = `
      <strong>Trạng thái:</strong> ${attended}/${total} sinh viên đã được điểm danh.
      ${unattended > 0 ? `Còn ${unattended} sinh viên chưa điểm danh.` : 'Tất cả sinh viên đã điểm danh.'}
    `;

    if (unattended === 0) {
      counterElement.className = 'alert alert-success mb-3';
    } else {
      counterElement.className = 'alert alert-info mb-3';
    }
  }

  // Update attendance data when form changes
  function updateAttendanceData(event) {
    const studentId = event.target.getAttribute('data-student');
    const student = attendanceData.find(s => s.maSv === studentId);

    if (student) {
      if (event.target.classList.contains('attendance-status')) {
        student.trangThai = event.target.value || null;

        // Auto-set time in when status is selected
        if (event.target.value && !student.thoiGianVao) {
          const timeInput = document.querySelector(`.time-in[data-student="${studentId}"]`);
          if (timeInput && !timeInput.value) {
            const now = new Date();
            timeInput.value = now.toTimeString().slice(0, 5);
            student.thoiGianVao = timeInput.value;
          }
        }
      } else if (event.target.classList.contains('time-in')) {
        student.thoiGianVao = event.target.value || null;
      } else if (event.target.classList.contains('time-out')) {
        student.thoiGianRa = event.target.value || null;
      }
    }

    updateAttendanceCounter();
  }

  // Quick attendance actions
  function markAllPresent() {
    document.querySelectorAll('.attendance-status').forEach(select => {
      select.value = 'CO_MAT';
      select.dispatchEvent(new Event('change'));
    });
  }

  function markAllAbsent() {
    document.querySelectorAll('.attendance-status').forEach(select => {
      select.value = 'VANG_MAT';
      select.dispatchEvent(new Event('change'));
    });

    // Clear times for absent students
    document.querySelectorAll('.time-in, .time-out').forEach(input => {
      const studentId = input.getAttribute('data-student');
      const student = attendanceData.find(s => s.maSv === studentId);
      if (student && student.trangThai === 'VANG_MAT') {
        input.value = '';
        input.dispatchEvent(new Event('change'));
      }
    });
  }

  function clearAllAttendance() {
    document.querySelectorAll('.attendance-status').forEach(select => {
      select.value = '';
      select.dispatchEvent(new Event('change'));
    });

    document.querySelectorAll('.time-in, .time-out').forEach(input => {
      input.value = '';
      input.dispatchEvent(new Event('change'));
    });
  }

  // Save manual attendance
  async function saveManualAttendance() {
    const scheduleId = document.getElementById('attendanceSchedule').value;
    const attendanceDate = document.getElementById('attendanceDate').value;

    if (!scheduleId || !attendanceDate) {
      showNotification('Vui lòng chọn buổi học!', 'warning');
      return;
    }

    // Validate date is today
    const today = new Date().toISOString().split('T')[0];
    if (attendanceDate !== today) {
      showNotification('Chỉ có thể điểm danh cho ngày hôm nay!', 'warning');
      return;
    }

    // Prepare attendance requests
    const requests = attendanceData
            .filter(student => student.trangThai)
            .map(student => ({
              maSv: student.maSv,
              trangThai: student.trangThai,
              thoiGianVao: student.thoiGianVao,
              thoiGianRa: student.thoiGianRa
            }));

    if (requests.length === 0) {
      showNotification('Vui lòng điểm danh ít nhất một sinh viên!', 'warning');
      return;
    }

    try {
      const response = await fetch(`/api/diemdanh/manual?maLich=${scheduleId}&ngayDiemDanh=${attendanceDate}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(requests)
      });

      if (response.ok) {
        const result = await response.json();
        showNotification(`Đã lưu điểm danh cho ${result.length} sinh viên!`, 'success');

        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('manualAttendanceModal'));
        modal.hide();

        // Refresh data
        loadAttendanceStats();
        loadStudentAttendanceData();
      } else {
        const error = await response.text();
        showNotification('Lỗi khi lưu điểm danh: ' + error, 'danger');
      }
    } catch (error) {
      console.error('Error saving attendance:', error);
      showNotification('Có lỗi xảy ra khi lưu điểm danh!', 'danger');
    }
  }

  // Export student list
  function exportStudentList() {
    const className = document.querySelector('.class-title')?.textContent || '';
    const classCode = document.querySelector('.class-code')?.textContent || '';

    let studentList = '';
    document.querySelectorAll('.student-card').forEach((card, index) => {
      const name = card.querySelector('.student-details h6')?.textContent || '';
      const id = card.querySelector('.student-id')?.textContent || '';
      studentList += `<tr><td>${index + 1}</td><td>${id}</td><td>${name}</td><td></td></tr>`;
    });

    const printWindow = window.open('', '_blank');
    printWindow.document.write(`
      <!DOCTYPE html>
      <html><head><title>Danh sách ${classCode}</title>
      <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ddd; padding: 8px; }
        th { background: #f2f2f2; }
      </style></head>
      <body>
        <h2>DANH SÁCH LỚP HỌC PHẦN</h2>
        <h3>${className} - ${classCode}</h3>
        <p>Ngày in: ${new Date().toLocaleDateString('vi-VN')}</p>
        <table>
          <tr><th>STT</th><th>Mã SV</th><th>Họ tên</th><th>Chữ ký</th></tr>
          ${studentList}
        </table>
      </body></html>
    `);
    printWindow.document.close();
    printWindow.print();
  }

  // Add loading animations
  function addLoadingAnimations() {
    // Add loading states to cards
    document.querySelectorAll('.student-card, .attendance-card').forEach(card => {
      card.style.opacity = '0';
      card.style.transform = 'translateY(20px)';
    });

    // Animate cards in
    setTimeout(() => {
      document.querySelectorAll('.student-card, .attendance-card').forEach((card, index) => {
        setTimeout(() => {
          card.style.transition = 'all 0.3s ease';
          card.style.opacity = '1';
          card.style.transform = 'translateY(0)';
        }, index * 50);
      });
    }, 100);
  }

  console.log('Class details page loaded successfully');
</script>

</body>
</html>"
	at org.attoparser.MarkupParser.parseDocument(MarkupParser.java:366)
